<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately minimal. Idle needs one thing: the package name of the window that just opened.

    canRetrieveWindowContent is not requested, so Idle cannot read what is on screen. No package
    filter is set because the user chooses which apps a rule covers at runtime, and the filtering
    happens in the app rather than in this configuration.

    android:isAccessibilityTool is absent on purpose: Idle is a digital wellbeing app, not an
    accessibility tool, and claiming otherwise would breach Google Play policy.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
