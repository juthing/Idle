<?xml version="1.0" encoding="utf-8"?>
<!--
    Unlock methods are local secrets and blocking state must not survive a restore
    onto another device, so nothing is backed up.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
