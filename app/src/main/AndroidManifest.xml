<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Each permission serves exactly one unlock method and is requested when that method is
        created, not at first launch. The matching features are declared optional so that a device
        without a camera or an NFC chip can still install Idle and use the other methods.
    -->
    <!--
        Usage access is granted by the user in Android settings, not by a runtime prompt. It is
        what lets Idle recover a day's totals after a reboot, when its own counting has a hole.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Idle has to put its block screen in front of the app the user just opened. Android only
        allows an app to start an activity from the background under a short list of exemptions,
        and running an accessibility service is not one of them — this permission is. Without it
        the system drops the launch without a word and the app looks broken.

        Idle never draws an actual overlay window: the permission is held solely for that
        exemption, and the user grants it by hand in Android settings.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!--
        Idle needs to list the apps the user can launch, so that they can pick which ones a rule
        covers. This intent filter is the narrow alternative to QUERY_ALL_PACKAGES, which Google
        Play treats as a sensitive permission and which Idle does not need.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".IdleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Idle">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Idle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The block screen. excludeFromRecents keeps it out of the recents list: it is an
            interruption, not a place the user navigates back to. It finishes itself when it
            stops, rather than relying on noHistory, which does not survive being re-launched for
            a second app while the first instance is still finishing.
        -->
        <activity
            android:name=".blocking.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".blocking"
            android:theme="@style/Theme.Idle" />

        <!--
            Idle provides its own WorkManager configuration so that workers can be injected, so
            the default initializer is removed rather than left to race with it.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name=".blocking.IdleAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
